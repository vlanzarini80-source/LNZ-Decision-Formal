import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {readFileSync,mkdtempSync,writeFileSync} from 'node:fs';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {runTrusted} from '../core/trusted-runtime.ts';
import {trustedAdapter} from '../core/trusted-adapter.ts';
import {TrustedReceiptStore} from '../core/trusted-receipt.ts';
import {SQLiteBudgetStore} from '../core/sqlite-budget.ts';
import {initialBudget} from '../core/budget.ts';
import {DatabaseSync} from 'node:sqlite';
const dir=mkdtempSync(join(tmpdir(),'lnz-runtime-'));
const receipts=join(dir,'receipts.db');
const registry=new TrustedReceiptStore(receipts,readFileSync('worker-public.pem','utf8'),process.env.LNZ_WORKER_COMMIT!,process.env.LNZ_EXPECTED_VERSION!);
const budget=new SQLiteBudgetStore(join(dir,'budget.db'));
const statement='(α : Type) (xs ys : List α) : (xs ++ ys).reverse = ys.reverse ++ xs.reverse';
const context=(s:string)=>'import Lean\nset_option autoImplicit false\ntheorem lnz_candidate '+s+' := by\n';
let calls=0,proposals=0;
const events:any[]=[];
const provider={id:'scripted-infrastructure-control',async expand(){return []},async propose(s:string,d:readonly string[]){proposals++;return {statement:s,proof:'by\n  '+(d.length?'simp':'rfl')}}};
const store={async append(e:any){events.push(e)}};
const transport=async(raw:string)=>{calls++;const p=spawnSync('python3',['signed-worker/runtime_transport.py'],{input:raw,encoding:'utf8',env:{...process.env,PYTHONPATH:process.cwd()+'/worker'},timeout:150000});assert.equal(p.status,0,p.stderr);return p.stdout.trim()};
const adapter=trustedAdapter(registry,context,transport);
const fake={id:'synthetic',async verify(){throw Error('MUST_NOT_CALL')}};
const copied={...fake,id:adapter.id};
const start=(id:string)=>budget.create(id,initialBudget({provider:4,verifier:2,lemma:0},Date.now()+300000));
try{
 start('fake');await assert.rejects(runTrusted('fake',statement,{provider,store,verifier:fake},budget),/UNTRUSTED_VERIFIER/);
 start('copied');await assert.rejects(runTrusted('copied',statement,{provider,store,verifier:copied},budget),/UNTRUSTED_VERIFIER/);
 assert.equal(calls,0);assert.equal(proposals,0);assert.equal((await budget.load('fake')).revision,0);assert.equal((await budget.load('copied')).revision,0);
 assert.equal(Reflect.set(adapter,'verify',fake.verify),false);
 start('real');const result=await runTrusted('real',statement,{provider,store,verifier:adapter},budget);
 assert.equal(result.status,'RUNNER_ACCEPTANCE_UNATTESTED');assert.equal(result.certified,false);assert.equal(calls,2);assert.equal(proposals,2);
 const states=events.filter(e=>e.runId==='real'&&e.kind==='STATE');assert.equal(states.length,2);assert.equal(states[0].data.phase,'READY');
 const db=new DatabaseSync(receipts);const rows=db.prepare('SELECT payload,signature FROM trusted_receipts').all();assert.equal(rows.length,2);assert.deepEqual(rows.map(r=>JSON.parse(String(r.payload)).status).sort(),['ACCEPTED','REJECTED']);
 const tampered=trustedAdapter(registry,context,async raw=>{const x=JSON.parse(await transport(raw));x.payload+=' ';return JSON.stringify(x)});
 start('tampered');const bad=await runTrusted('tampered',statement,{provider,store,verifier:tampered},budget);assert.equal(bad.status,'STOPPED_ERROR');assert.match(String(bad.error),/SIGNATURE/);assert.equal(bad.certified,false);
 assert.equal(db.prepare('SELECT count(*) AS n FROM trusted_receipts').get()?.n,2);assert.equal(db.prepare('SELECT count(*) AS n FROM trusted_quarantine').get()?.n,1);
 writeFileSync('runtime-audit-evidence.json',JSON.stringify({result,bad,events,rows,budget:budget.events('real')},null,2));db.close();
 console.log('TRUSTED_RUNTIME_REAL_LEAN_PASS six scoped controls');
}finally{registry.close();budget.close()}
